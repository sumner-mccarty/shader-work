// ═══════════════════════════════════════════════════════════════════════════
// REALISTIC — Boutique rack gear. Brushed metal, real screws, lit from one lamp.
//
// "$base" names the AUTHORED states.json each part is built from. The dark mode adds no
// overrides, so SkinForge rosters those files directly and bakes nothing — dark IS the authored
// look, byte for byte. The light mode is a pure recolour of the same geometry: every bevel,
// pattern, screw and shadow survives, because light/dark is a MODE of one style rather than two
// unrelated styles. The hardware doesn't change; the room does.
//
// Generated by Tools/build_recipes.py. Colours here and in Tools/design_*.py are the same
// palette — edit either and re-run, or edit the baked states.json in the Designer and stop
// caring that this file exists.
// ═══════════════════════════════════════════════════════════════════════════
{
  "styleName": "Realistic",
  "title": "Realistic",
  "order": 1,
  "author": "DrumSumDrum",
  "blurb": "Boutique rack gear. Brushed metal, real screws, lit from one lamp.",
  "stateShifts": {
    "Hover": 0.08,
    "Pressed": -0.1,
    "Active": 0.16,
    "Disabled": -0.22
  },
  "families": {
    "Button": {
      "$base": "RealisticButton"
    },
    "Knob": {
      "$base": "RealisticKnob"
    },
    "Slider": {
      "$base": "RealisticSlider"
    },
    "Toggle": {
      "$base": "RealisticPill"
    },
    "Panel": {
      "$base": "RealisticFace"
    }
  },
  "roles": {
    // 2026-09-05 promotion: these role choices (everything except panel.faceplate/display.well,
    // which stay $inherit — see below) match a hand-tuned live theme named "My Realistic Dark"
    // that the user rated ~65% correct, the best of the four shipped styles. Promoted here so it
    // IS "Realistic Dark" rather than a separate user file. Still open work per that rating — this
    // is a snapshot of where it stood, not a claim that it's finished.
    "pad": {
      "$base": "RealisticPad"
    },
    "button.standard": {
      "$base": "GreyButtonRM"
    },
    "button.small": {
      "$base": "GreyButtonRM"
    },
    "button.wide": {
      "$base": "GreyButtonRM"
    },
    "button.accent": {
      "$base": "AccentButtonRM"
    },
    // The hero nodes (Login/Profile/ChallengePublish) author GreyButtonRM. The old base here was
    // "FlatDark.pad" — a Flat look's BAKED name, never a file — so SkinForge skipped the role and
    // the layout's GreyButtonRM showed through. Naming it keeps that look and stops the warning.
    "button.hero": {
      "$base": "GreyButtonRM"
    },
    "toggle.button": {
      "$base": "MuteToggleRM"
    },
    "toggle.pill": {
      "$base": "UI_SDFTogglePill"
    },
    "button.close": {
      "$base": "CloseButtonRM"
    },
    "lamp": {
      "$base": "EnableLampRM"
    },
    "knob.hero": {
      "$base": "RedKnobRM"
    },
    "knob.large": {
      "$base": "RedKnobRM"
    },
    "knob.medium": {
      "$base": "RedKnobRM"
    },
    "knob.small": {
      "$base": "RedKnobRM"
    },
    "slider.long": {
      "$base": "RackSlider"
    },
    "slider.standard": {
      "$base": "RackSlider"
    },
    // panel.faceplate / display.well: hardware, not software — each Mixer module's faceplate is
    // hardcoded in its layout doc (RackFaceplateCream/Green/Blue/Rust/Silver/Graphite) so the rack
    // reads as ASSEMBLED GEAR, not one uniform screen. "$inherit" tells the baker to leave the
    // role out of this look's roster entirely, so that per-module colour shows through untouched
    // — see SkinForge.IsInherit. Found 2026-09-05: every shipped style was overriding this to one
    // colour, silently flattening the rack the moment any named look was applied. "My Realistic
    // Dark" never listed these roles either — this preserves that, byte for byte.
    "panel.faceplate": {
      "$base": "$inherit"
    },
    "panel.socket": {
      "$base": "PadSocket"
    },
    "panel.inset": {
      "$base": "RackPlateInset"
    },
    "display.well": {
      "$base": "$inherit"
    },
    "panel.backplane": {
      "$base": "RackBackplane"
    }
  },
  "modes": {
    "dark": {
      "trackTheme": "Nebula",
      "blurb": "Lit at the club. Graphite faceplates, warm lamps, deep shadow.",
      "colors": {
        "face": "#2A2F36",
        "inset": "#1E2228",
        "backplane": "#111418",
        "well": "#0A1822",
        "body": "#3D434B",
        "bodyAlt": "#2E343B",
        "accent": "#4FD1E0",
        "line": "#4A5058",
        "hot": "#D2544A",
        "lamp": "#6EE7A8",
        "mark": "#DCE2EA"
      },
      "chrome": {
        "headerBg": "#111418",
        "headerBorder": "#4A505800",
        "tabFillBottom": "#1E2228",
        "tabFillTop": "#2A2F36",
        "tabFillActiveBottom": "#3D434B",
        "tabFillActiveTop": "#2E343B",
        "label": "#DCE2EA",
        "labelActive": "#DCE2EA",
        "icon": "#DCE2EA",
        "iconActive": "#4FD1E0",
        "gear": "#DCE2EACC",
        "meatballIdle": "#DCE2EA",
        "meatballLit": "#4FD1E0"
      },
      "palettes": {
        "ui": {
          "text": "#E6EBF2",
          "textDim": "#8A93A0",
          "textFaint": "#5A6674",
          "accent": "#4FD1E0",
          "warn": "#FFB84D",
          "danger": "#FF6B6B",
          "ok": "#6EE7A8"
        },
        "surface": {
          "card": "#1C1F24FA",
          "cardEdge": "#2B3440",
          "divider": "#1E242C",
          "scrim": "#000000B8"
        }
      }
    },
    // LIGHT (rebuilt 2026-09-13) — "silver hardware". The first light mode recoloured the
    // CONTROLS (pale knobs, pale keys, pale lamps) while every faceplate, display and lane stayed
    // the dark authored hardware, so light plates sat inside dark frames, the lamps' Active glow
    // blew out to white, and every literal light glyph vanished on a light key. Now the CHASSIS
    // changes and the controls don't: graphite faceplates are re-finished as brushed aluminium
    // (a "swap" — the cream/green/blue/rust modules keep their own metal), insets become dark
    // anodised plates instead of black holes, the backplane is a mid-grey rail, and the lanes
    // go light. Knobs, keys, lamps, pads and LCD wells are byte-for-byte Realistic Dark: dark
    // parts on light metal is how real daylight gear is built, and it keeps every glyph legible.
    "light": {
      "trackTheme": "Nebula",
      "blurb": "Daylight studio. Brushed aluminium, milled plates, black knobs.",
      // Its own rig: the club rig's warm key + blue fill fall off hard across the screen, which
      // painted the same aluminium plate ~190 grey at the top bar and ~105 in the mixer — the
      // "mixer silver clashes with everything else" report. A high, distant white key is even
      // to within ~15% edge to edge (measured offline, 2026-09-13).
      "lights": "Themes/RealisticLight.theme",
      "colors": {
        "face": "#C2C6CB",
        "inset": "#A3A8AE",
        "backplane": "#8B9097",
        "well": "#0A1822",
        "body": "#3D434B",
        "bodyAlt": "#2E343B",
        "accent": "#0E7C8C",
        "line": "#8D949C",
        "hot": "#D2544A",
        "lamp": "#6EE7A8",
        "mark": "#1B1F26"
      },
      "chrome": {
        "headerBg": "#B3B7BC",
        "headerBorder": "#8D949C00",
        "tabFillBottom": "#A3A8AE",
        "tabFillTop": "#C2C6CB",
        "tabFillActiveBottom": "#B3B7BC",
        "tabFillActiveTop": "#CFD2D6",
        "label": "#1B1F26",
        "labelActive": "#1B1F26",
        "icon": "#1B1F26",
        "iconActive": "#0E7C8C",
        "gear": "#1B1F26CC",
        "meatballIdle": "#1B1F26",
        "meatballLit": "#0E7C8C"
      },
      "palettes": {
        "ui": {
          "text": "#171B21",
          "textDim": "#4A525C",
          "textFaint": "#6A727C",
          "accent": "#0E7C8C",
          "warn": "#A4691B",
          "danger": "#B03A3A",
          "ok": "#2E7D50"
        },
        "surface": {
          "card": "#D6DADFFA",
          "cardEdge": "#A8AEB6",
          "divider": "#BEC3CA",
          "scrim": "#2A2E34A0"
        },
        // Print on a surface this look re-finished (PrintInk): light neutral literals printed on
        // aluminium become these. Bright source -> <surface>, dim source -> <surface>Dim.
        "ink": {
          "faceplate": "#1B1F26",
          "faceplateDim": "#4E5661",
          "inset": "#1B1F26",
          "insetDim": "#454C56",
          "backplane": "#15191F",
          "backplaneDim": "#353C46",
          "socket": "#1B1F26",
          "socketDim": "#454C56",
          "reviewBar": "#1B1F26",
          "reviewBarDim": "#4A525C"
        },
        // The multitrack's review bar (OnionControlBar) in the strip's own aluminium.
        "review": {
          "slot": "#6E7682",
          "slotFill": "#C9CDD2",
          // Verdict inks re-cut for a LIGHT ground (2026-09-20): the neon dark-mode set was
          // green-on-grey / amber-on-grey at ~1.5:1. These are the same hues at ~4.5:1+.
          "exact": "#03725A",
          "perfect": "#3B7A14",
          "early": "#1A5FB4",
          "late": "#B05400",
          "wayOff": "#C0281A",
          "missed": "#B0142C",
          "extra": "#8A26B8",
          "heatCold": "#A01E30",
          "heatMid": "#9A6A00",
          "heatHot": "#1E7A44",
          "heatUntried": "#6A727C",
          "bar": "#A3A8AEF0",
          "barRule": "#0000001F"
        },
        "plate": {
          "ink": "#1B1F26F0",
          "label": "#2E343C",
          "labelBright": "#262B32",
          "glyph": "#3A4552",
          "dim": "#4E5661"
        },
        // Every LED readout: a TAN reflective LCD with dark orange digits (2026-09-13, user pick
        // "D" of seven rendered options — the dark amber well read as a hole in the aluminium and
        // was too contrasty to read comfortably). `warn` must stay distinct on tan: dark red.
        "display": {
          "text": "#7A3208",
          "textDim": "#9A4A18",
          "textAlt": "#8A3E10",
          "warn": "#B01E0E"
        },
        // The multitrack in the same aluminium family as the chassis around it.
        "tracks": {
          "noteSeparator": "#E6E8EA",
          "backdrop": "#8B9097",
          "strip": "#A3A8AE",
          "rowWithSample": "#C2C6CB",
          "rowEmpty": "#B3B7BC",
          "rowNotesNoSample": "#CDB5B5",
          "text": "#1B1F26",
          "ruler": "#2E343CE6",
          "playhead": "#1B1F26E6",
          "recMarker": "#C8402ADC",
          "scrollbar": "#00000030"
        }
      },
      "roles": {
        "panel.inset": {
          "_PanelColor": "$inset",
          "_PanelGradientColorA": "#989DA3",
          "_PanelGradientColorB": "#ADB2B8",
          "_PanelScrewColor": "#8A9098"
        },
        "panel.backplane": {
          "_PanelColor": "$backplane",
          "_PanelGradientColorA": "#83888F",
          "_PanelGradientColorB": "#93989F"
        }
      },
      // Knobs, keys, toggles, lamps, pads and LCD wells stay Realistic Dark's: black controls on
      // aluminium is how daylight gear is built, and it keeps every glyph and latch colour intact
      // (a recoloured MuteToggle loses its red Active state to the recipe's derived-state shift).
      "swaps": {
        "RackFaceplateRust": "RackFaceplateRustLight",
        "RackFaceplateGreen": "RackFaceplateGreenLight",
        "RackFaceplateCream": "RackFaceplateCreamLight",
        "RackFaceplateBlue": "RackFaceplateBlueLight",
        "RackFaceplateBlack": "RackFaceplateBlackLight",
        "RackFaceplate": "RackFaceplateLight",
        "RackFaceplateGraphite": "RackFaceplateGraphiteLight",
        "RackFaceplateSilver": "RackFaceplateSilverLight",
        "RackScrollTrack": {
          "_PanelColor": "#A3A8AE",
          "_PanelGradientColorA": "#989DA3",
          "_PanelGradientColorB": "#ADB2B8"
        },
        // The scroll HANDLE fills most of its track when the lanes fit, so a dark handle read as
        // a black bar down the multitrack. One low-contrast step darker than the track: findable,
        // never louder than the notes it scrolls.
        "RackScrollHandle": {
          "_ButtonColor": "#9297A0",
          "_ButtonGradientColorA": "#8A8F96",
          "_ButtonGradientColorB": "#9DA2A9",
          "_ButtonGradientColorC": "#90959C"
        },
        // The multitrack's zoom faders and reset dot sit in the same corner gutter as the
        // scrollbars and were the last black block in it. Same low-contrast aluminium steps.
        "RackGutterFader": {
          "_BgColor": "#A3A8AE",
          "_BgGradientColorA": "#989DA3",
          "_BgGradientColorB": "#ADB2B8",
          "_TrackColor": "#8E939A",
          "_TrackGradientColorA": "#868B92",
          "_TrackGradientColorB": "#969BA2"
        },
        "RackDot": {
          "_ButtonColor": "#9297A0",
          "_ButtonGradientColorA": "#8A8F96",
          "_ButtonGradientColorB": "#9DA2A9",
          "_ButtonGradientColorC": "#90959C"
        },
        // Every LCD well goes tan with the digits above (layouts author the blue one).
        "LedWellBlue": {
          "$base": "LedWellAmber",
          "_PanelColor": "#D8B07A",
          "_PanelGradientColorA": "#CBA06A",
          "_PanelGradientColorB": "#E3BF8C"
        },
        // The waveform's bezel: a pale aluminium edge instead of the graphite one.
        "DisplayBezel": {
          "_PanelColor": "#E1E4E8"
        }
      }
    }
  }
}
