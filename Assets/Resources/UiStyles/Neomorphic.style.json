// ═══════════════════════════════════════════════════════════════════════════
// NEOMORPHIC — Everything moulded from the same block. Soft shadow does all the work.
//
// "$base" names the AUTHORED states.json each part is built from. The dark mode adds no
// overrides, so SkinForge rosters those files directly and bakes nothing — dark IS the authored
// look, byte for byte. The light mode is a pure recolour of the same geometry: every bevel,
// pattern, screw and shadow survives, because light/dark is a MODE of one style rather than two
// unrelated styles. The hardware doesn't change; the room does.
//
// Generated by Tools/build_recipes.py. Colours here and in Tools/design_*.py are the same
// palette — edit either and re-run, or edit the baked states.json in the Designer and stop
// caring that this file exists.
// ═══════════════════════════════════════════════════════════════════════════
{
  "styleName": "Neomorphic",
  "title": "Neomorphic",
  "order": 2,
  "author": "DrumSumDrum",
  "blurb": "Everything moulded from the same block. Soft shadow does all the work.",
  "stateShifts": {
    "Hover": 0.08,
    "Pressed": -0.1,
    "Active": 0.16,
    "Disabled": -0.22
  },
  "families": {
    "Button": {
      "$base": "NeoButton"
    },
    "Knob": {
      "$base": "NeoKnob"
    },
    "Slider": {
      "$base": "NeoSlider"
    },
    "Toggle": {
      "$base": "NeoPill"
    },
    "Panel": {
      "$base": "NeoFace"
    }
  },
  "roles": {
    "pad": {
      "$base": "NeoPad"
    },
    "button.accent": {
      "$base": "NeoAccent"
    },
    "button.hero": {
      "$base": "NeoAccent"
    },
    "toggle.button": {
      "$base": "NeoToggleBtn"
    },
    "button.close": {
      "$base": "NeoClose"
    },
    "lamp": {
      "$base": "NeoLamp"
    },
    "knob.hero": {
      "$base": "NeoKnobHero"
    },
    "knob.small": {
      "$base": "NeoKnobSmall"
    },
    "panel.faceplate": {
      "$base": "NeoFace"
    },
    "panel.socket": {
      "$base": "NeoInset"
    },
    "panel.inset": {
      "$base": "NeoInset"
    },
    "display.well": {
      "$base": "NeoWell"
    },
    "panel.backplane": {
      "$base": "NeoBack"
    }
  },
  "modes": {
    "dark": {
      // REBUILT 2026-09-13 on the Neomorphic Light structure: every part rosters a generated
      // NeoDark*.states.json (Tools/design_neomorphic.py) with every state set on purpose, sharing
      // Light's geometry fixes (no unauthored knob drop shadow, lipless caps, untilted pads, tight
      // tray insets). Only the palette, ambient and shadow strength differ.
      "trackTheme": "Nebula",
      "blurb": "Charcoal clay. Everything moulded from the same block.",
      "lights": "Themes/NeomorphicDark.theme",
      // Every screen wears a soft moulded Neomorphic finish (UiThemes/ScopeFinishes.json),
      // not Realistic's amber glass, LED matrices and phosphor tubes.
      "displays": { "glass.amber": "neo.dark", "glass.cyan": "neo.dark", "lcd.grey": "neo.dark", "crt.phosphor": "neo.dark", "plastic.blue": "neo.dark", "flat": "neo.dark", "*": "neo.dark", "led.matrix.green": "neo.dark.meter", "led.matrix.amber": "neo.dark.meter", "waveform": "neo.dark.waveform" },
      "colors": {
        "face": "#2C3036",
        "inset": "#262A30",
        "backplane": "#23262B",
        "well": "#161A20",
        "body": "#31353C",
        "bodyAlt": "#272A30",
        "accent": "#4A9BF5",
        "line": "#3A3F47",
        "hot": "#E8705F",
        "lamp": "#5AB0FF",
        "mark": "#AEB6C2"
      },
      "chrome": {
        "headerBg": "#23262B",
        "headerBorder": "#3A3F4700",
        "tabFillBottom": "#262A30",
        "tabFillTop": "#31353C",
        "tabFillActiveBottom": "#2C3036",
        "tabFillActiveTop": "#373C44",
        "label": "#AEB6C2",
        "labelActive": "#DCE2EA",
        "icon": "#AEB6C2",
        "iconActive": "#4A9BF5",
        "gear": "#AEB6C2CC",
        "meatballIdle": "#AEB6C2",
        "meatballLit": "#4A9BF5"
      },
      "palettes": {
        "ui": {
          "text": "#D6DCE4",
          "textDim": "#8A93A0",
          "textFaint": "#5E6674",
          "accent": "#4A9BF5",
          "warn": "#F0B457",
          "danger": "#E8705F",
          "ok": "#7EE8B0"
        },
        "surface": {
          "card": "#2C3036FA",
          "cardEdge": "#3A3F47",
          "divider": "#262A30",
          "scrim": "#0B0D10B8",
          "backdrop": "#1E2126",
          "gap": "#1E2126"
        },
        // Light ink for PLATES only (2026-09-13): the cream/silver modules print dark silkscreen
        // (GN-UV, CL-76) that vanishes on this look's uniform charcoal faceplates; PrintInk flips
        // dark neutral print when the surface ink is light. No "key": C# prints dark marks on keys.
        "ink": {
          "faceplate": "#D6DCE4", "faceplateDim": "#8A93A0",
          "inset": "#D6DCE4", "insetDim": "#8A93A0",
          "backplane": "#D6DCE4", "backplaneDim": "#8A93A0",
          "socket": "#D6DCE4", "socketDim": "#8A93A0",
          "reviewBar": "#D6DCE4", "reviewBarDim": "#8A93A0"
        },
        // Every LED readout: dark recessed glass, cyan digits.
        "display": {
          "text": "#62D6FF",
          "textDim": "#3E9CC8",
          "textAlt": "#9FE6FF",
          "warn": "#FFB84D"
        },
        "review": {
          "bar": "#23262BF0",
          "barRule": "#FFFFFF14"
        }
      },
      "families": {
        "Button": { "$base": "NeoDarkButton" },
        "Knob": { "$base": "NeoDarkKnob" },
        "Slider": { "$base": "NeoDarkSlider" },
        "Toggle": { "$base": "NeoDarkPill" },
        "Panel": { "$base": "NeoDarkFace" }
      },
      // Role beats family, so every role the style-level block names is re-named here.
      "roles": {
        "pad": { "$base": "NeoDarkPad" },
        "button.accent": { "$base": "NeoDarkAccent" },
        "button.hero": { "$base": "NeoDarkAccent" },
        "toggle.button": { "$base": "NeoDarkToggleBtn" },
        "button.close": { "$base": "NeoDarkClose" },
        "lamp": { "$base": "NeoDarkLamp" },
        "knob.hero": { "$base": "NeoDarkKnobHero" },
        "knob.small": { "$base": "NeoDarkKnobSmall" },
        "panel.faceplate": { "$base": "NeoDarkFace" },
        "panel.socket": { "$base": "NeoDarkInset" },
        "panel.inset": { "$base": "NeoDarkInset" },
        "display.well": { "$base": "NeoDarkWell" },
        "panel.backplane": { "$base": "NeoDarkBack" }
      },
      // Skins the multitrack loads BY NAME (not through a layout role).
      "swaps": {
        "LedWellBlue": "NeoDarkWell",
        "GreyButtonRM": "NeoDarkButton",
        "MuteToggleRM": "NeoDarkToggleBtn",
        "SoloToggleRM": "NeoDarkToggleBtn",
        "DisplayBezel": {
          "_PanelColor": "#3A3F47",
          "_LightingAmbient": 0.9
        },
        "RackScrollTrack": {
          "_PanelColor": "#23262B",
          "_PanelGradientColorA": "#202328",
          "_PanelGradientColorB": "#262A30",
          "_LightingAmbient": 0.9
        },
        "RackScrollHandle": {
          "_ButtonColor": "#3A3F47",
          "_ButtonGradientColorA": "#353A42",
          "_ButtonGradientColorB": "#40454E",
          "_ButtonGradientColorC": "#3A3F47",
          "_LightingAmbient": 0.9
        },
        "RackGutterFader": {
          "_BgColor": "#23262B",
          "_BgGradientColorA": "#202328",
          "_BgGradientColorB": "#262A30",
          "_TrackColor": "#1E2126",
          "_TrackGradientColorA": "#1B1E22",
          "_TrackGradientColorB": "#22252A",
          "_TrackValueFilledColor": "#4A9BF5",
          "_HandleColor": "#373C44",
          "_LightingAmbient": 0.9
        },
        "RackDot": {
          "_ButtonColor": "#3A3F47",
          "_ButtonGradientColorA": "#353A42",
          "_ButtonGradientColorB": "#40454E",
          "_ButtonGradientColorC": "#3A3F47",
          "_LightingAmbient": 0.9
        }
      }
    },
    "light": {
      // REBUILT 2026-09-13 (second pass) against the user's references: one pale cool-grey
      // material; knobs, handles and keys that rise out of the plate and fade back into it.
      //
      // STRUCTURE IS AUTHORED, NOT RECOLOURED. Every part rosters a dedicated NeoLight*.states.json
      // (generated from the Neo skins, every state set on purpose). The first pass recoloured the
      // dark skins through this recipe, and a recipe pushes ONE value into every state that
      // declares a property — the bypass lamp's Active icon came out as its Normal colour shifted a
      // touch lighter, so on and off looked identical. No overrides below: each role names its file.
      "trackTheme": "Nebula",
      "blurb": "Soft white. Moulded from one pale material, lit from above.",
      "lights": "Themes/NeomorphicLight.theme",
      // Every screen wears a soft moulded Neomorphic finish (UiThemes/ScopeFinishes.json),
      // not Realistic's amber glass, LED matrices and phosphor tubes.
      "displays": { "glass.amber": "neo.light", "glass.cyan": "neo.light", "lcd.grey": "neo.light", "crt.phosphor": "neo.light", "plastic.blue": "neo.light", "flat": "neo.light", "*": "neo.light", "led.matrix.green": "neo.light.meter", "led.matrix.amber": "neo.light.meter", "waveform": "neo.light.waveform" },
      "colors": {
        "face": "#E6E9EE",
        "inset": "#D9DDE4",
        "backplane": "#D3D7DE",
        "well": "#D0D5DD",
        "body": "#E8EBF0",
        "bodyAlt": "#D9DDE3",
        "accent": "#3F7FD6",
        "line": "#D2D7DF",
        "hot": "#E0655A",
        "lamp": "#2F7BEA",
        "mark": "#5A6272"
      },
      "chrome": {
        "headerBg": "#DCE0E6",
        "headerBorder": "#C9CED600",
        "tabFillBottom": "#DFE2E8",
        "tabFillTop": "#E9ECF1",
        "tabFillActiveBottom": "#E6E9EE",
        "tabFillActiveTop": "#F2F4F7",
        "label": "#4A5160",
        "labelActive": "#2C323C",
        "icon": "#4A5160",
        "iconActive": "#3F7FD6",
        "gear": "#4A5160CC",
        "meatballIdle": "#4A5160",
        "meatballLit": "#3F7FD6"
      },
      "palettes": {
        "ui": {
          "text": "#2C323C",
          "textDim": "#5E6674",
          "textFaint": "#8A92A0",
          "accent": "#3F7FD6",
          "warn": "#B07A20",
          "danger": "#C8483C",
          "ok": "#3E9A6A"
        },
        "surface": {
          "card": "#ECEFF3FA",
          "cardEdge": "#D3D8DF",
          "divider": "#D8DCE2",
          "scrim": "#2C323CA0",
          "backdrop": "#CDD2D9",
          "gap": "#CDD2D9"
        },
        // Print on surfaces this look re-finished (PrintInk).
        "ink": {
          "faceplate": "#3A414C", "faceplateDim": "#7A8290",
          "inset": "#3A414C", "insetDim": "#7A8290",
          "backplane": "#3A414C", "backplaneDim": "#7A8290",
          "socket": "#3A414C", "socketDim": "#7A8290",
          "key": "#4A5160", "keyDim": "#8A92A0",
          "reviewBar": "#3A414C", "reviewBarDim": "#7A8290"
        },
        // This look's own display: light recessed glass with deep-blue digits — a soft-UI readout,
        // not Realistic Dark's navy LCD dropped into a white rack.
        "display": {
          "text": "#2B5C9E",
          "textDim": "#5A7BA8",
          "textAlt": "#3A6CB0",
          "warn": "#C0392B"
        },
        "key": {
          "label": "#3A414C",
          "faceOff": "#E3E6EB",
          "edgeOff": "#C9CED6",
          "markOff": "#5E6674",
          "bankFaceOff": "#DADDE3",
          "bankEdgeOff": "#C9CED6"
        },
        // Empty pads pull toward the tray tone, not near-black: pale and quiet, still row-tinted.
        "pad": {
          "empty": "#D5DAE1A0"
        },
        "review": {
          "slot": "#8A92A0",
          "slotFill": "#DDE2E9",
          "bar": "#DFE2E8F0",
          "barRule": "#0000001A"
        },
        "tracks": {
          "noteSeparator": "#FFFFFF",
          "backdrop": "#D6DAE0",
          "strip": "#DFE2E8",
          "rowWithSample": "#EEF1F5",
          "rowEmpty": "#E6E9EE",
          "rowNotesNoSample": "#F0DCDC",
          "text": "#3A414C",
          "ruler": "#5E6674E6",
          "playhead": "#2C323CE6",
          "recMarker": "#D8483CDC",
          "scrollbar": "#0000001E"
        }
      },
      "families": {
        "Button": { "$base": "NeoLightButton" },
        "Knob": { "$base": "NeoLightKnob" },
        "Slider": { "$base": "NeoLightSlider" },
        "Toggle": { "$base": "NeoLightPill" },
        "Panel": { "$base": "NeoLightFace" }
      },
      // Every role the style-level block names has to be re-named here: role beats family, so a
      // style-level "knob.hero" -> NeoKnobHero would otherwise win over the Knob family above.
      "roles": {
        "pad": { "$base": "NeoLightPad" },
        "button.accent": { "$base": "NeoLightAccent" },
        "button.hero": { "$base": "NeoLightAccent" },
        "toggle.button": { "$base": "NeoLightToggleBtn" },
        "button.close": { "$base": "NeoLightClose" },
        "lamp": { "$base": "NeoLightLamp" },
        "knob.hero": { "$base": "NeoLightKnobHero" },
        "knob.small": { "$base": "NeoLightKnobSmall" },
        "panel.faceplate": { "$base": "NeoLightFace" },
        "panel.socket": { "$base": "NeoLightInset" },
        "panel.inset": { "$base": "NeoLightInset" },
        "display.well": { "$base": "NeoLightWell" },
        "panel.backplane": { "$base": "NeoLightBack" }
      },
      // Skins the multitrack loads BY NAME (not through a layout role).
      "swaps": {
        "LedWellBlue": "NeoLightWell",
        "GreyButtonRM": "NeoLightButton",
        "MuteToggleRM": "NeoLightToggleBtn",
        "SoloToggleRM": "NeoLightToggleBtn",
        "DisplayBezel": {
          "_PanelColor": "#F2F4F7",
          "_LightingAmbient": 0.5
        },
        "RackScrollTrack": {
          "_PanelColor": "#DADDE3",
          "_PanelGradientColorA": "#D4D8DE",
          "_PanelGradientColorB": "#E0E3E8",
          "_LightingAmbient": 0.5
        },
        "RackScrollHandle": {
          "_ButtonColor": "#C3C8D0",
          "_ButtonGradientColorA": "#BCC1C9",
          "_ButtonGradientColorB": "#CDD1D8",
          "_ButtonGradientColorC": "#C3C8D0",
          "_LightingAmbient": 0.5
        },
        "RackGutterFader": {
          "_BgColor": "#DADDE3",
          "_BgGradientColorA": "#D4D8DE",
          "_BgGradientColorB": "#E0E3E8",
          "_TrackColor": "#C9CED6",
          "_TrackGradientColorA": "#C3C8D0",
          "_TrackGradientColorB": "#CDD1D8",
          "_TrackValueFilledColor": "#3F7FD6",
          "_HandleColor": "#ECEFF3",
          "_LightingAmbient": 0.5
        },
        "RackDot": {
          "_ButtonColor": "#C3C8D0",
          "_ButtonGradientColorA": "#BCC1C9",
